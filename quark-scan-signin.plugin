#!name = 夸克扫描王自动签到
#!desc = 抓取夸克扫描王 Cookie/凭证并每日自动签到；首次使用请打开 App 进一次签到页；Cookie 失效后重新进一次即可
#!date = 2026-11-13
#!author = Scripting Agent

[Argument]
quark_signin = switch,true,tag=夸克签到任务
quark_cookie = switch,true,tag=夸克Cookie抓取
quark_time = input,"35 9 * * *",tag=签到定时

[Script]
request if ${url} ~= /scan-order\.quark\.cn/i then script("https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-cookie.js") with enable=${quark_cookie}, tag="夸克Cookie", timeout=60, requires_body=false

cron ${quark_time} then script("https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-signin.js") with enable=${quark_signin}, tag="夸克签到", timeout=120

[MITM]
hostname = %APPEND% scan-order.quark.cn
