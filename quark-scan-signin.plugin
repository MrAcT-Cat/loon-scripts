#!name = 夸克扫描王自动签到
#!desc = 配合 iOS 快捷指令每日自动打开 App；App 原生自动签到，Loon 拦截真实响应并推送结果通知（不伪造任何请求）
#!date = 2026-11-13
#!author = Scripting Agent

[Argument]
quark_signin = switch,true,tag=签到结果播报

[Script]
response if ${url} ~= /pDChohbxo82nCoIn/i then script("https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-notify.js") with enable=${quark_signin}, tag="夸克签到结果", timeout=60

request if ${url} ~= /pDChohbxo82nCoIn/i then script("https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-notify.js") with enable=${quark_signin}, tag="夸克签到请求", timeout=60, requires_body=false

[MITM]
hostname = scan-order.quark.cn
