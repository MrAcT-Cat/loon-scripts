#!name = 夸克扫描王签到状态提醒
#!desc = 打开签到页时读取真实响应，每天提醒一次当前连续签到天数。签到由 App 自行完成，本插件不主动签到、不伪造请求、不干扰签到。
#!date = 2026-11-28
#!loon_version = 3.5.1(983)
#!author = Scripting Agent

[Argument]
quark_notify_enable = switch,true,tag=签到状态提醒,desc=打开签到页后每天提醒一次当前连续天数

[Script]
response if ${url} ~= /^https:\/\/scan-order\.quark\.cn\/api\/sd6hJds8SIgn\/pOcKNmTupWelFare(?:\?|$)/i then script("https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-notify.js?v=20261128") with enable=${quark_notify_enable}, timeout=20, requires_body=true, tag="夸克签到状态"

[MITM]
hostname = scan-order.quark.cn
