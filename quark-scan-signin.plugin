#!name = 夸克扫描王自动签到
#!desc = 抓取夸克扫描王 Cookie/凭证并每日自动签到；首次使用请打开 App 进一次签到页；Cookie 失效后重新进一次即可
#!author = Scripting Agent
#!date = 2026-11-13

[Script]
ScanKingCookie = type=http-request, pattern=https?:\/\/scan-order\.quark\.cn\/api\/, requires-body=true, max-size=0, script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-cookie.js, timeout=10
ScanKingSignIn = type=cron, cronexp="35 9 * * *", script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/quark-scan-signin.js, timeout=60, enable=true

[MITM]
hostname = %APPEND% scan-order.quark.cn
