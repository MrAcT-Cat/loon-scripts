#!name = 穿墙猫每日签到
#!desc = 首次用 Safari 登录 wk.cqm.lol 并刷新仪表盘获取凭据；每日 08:05 检查后签到，已签跳过。人机验证失效时需手动打开网页验证并刷新。
#!date = 2026-11-27

[Script]
http-request ^https:\/\/wk\.cqm\.lol\/api\/v1\/user\/checkin\/status(?:\?|$) script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/cqm-checkin.js,requires-body=false,timeout=10,tag=穿墙猫获取凭据,enable=true
cron "5 8 * * *" script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/cqm-checkin.js,timeout=60,tag=穿墙猫每日签到,enable=true
generic script-path=https://raw.githubusercontent.com/MrAcT-Cat/loon-scripts/main/cqm-checkin.js,timeout=60,tag=穿墙猫手动测试,enable=true

[MITM]
hostname = wk.cqm.lol
